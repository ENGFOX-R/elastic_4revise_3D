tstress = .true.
verbosity = 'high'
dt = 50
/
&SYSTEM
ntyp =  5
occupations = 'smearing' !
smearing = "gaussian"
degauss = 0.05
ecutrho = 320
ecutwfc = 40
ibrav = 0
nat = 36
nosym = .TRUE.
