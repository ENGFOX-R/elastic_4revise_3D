electron_maxstep = 150
mixing_beta = 0.1
mixing_mode = "plain"
mixing_ndim = 4
diagonalization = "david"
diago_david_ndim = 2
/
&IONS
ion_dynamics = "damp"
ion_temperature = "rescaling"
tempw = 300
/
