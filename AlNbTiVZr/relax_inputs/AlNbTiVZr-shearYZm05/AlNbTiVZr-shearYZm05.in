&CONTROL
calculation = "relax"
nstep = 200
etot_conv_thr = 1.0d-5
forc_conv_thr = 1.0d-4
disk_io = "none"
pseudo_dir = '/opt/QEpot/SSSP_efficiency_pseudos/'
tprnfor = .true.
tstress = .true.
verbosity = 'high'
dt = 50
/
&SYSTEM
ntyp =  5
occupations = 'smearing' !
smearing = "gaussian"
degauss = 0.05
ecutrho = 320
ecutwfc = 40
ibrav = 0
nat = 36
nosym = .TRUE.
