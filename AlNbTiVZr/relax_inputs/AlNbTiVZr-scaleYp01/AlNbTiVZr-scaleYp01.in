&CONTROL
calculation = "relax"
nstep = 200
etot_conv_thr = 1.0d-5
forc_conv_thr = 1.0d-4
disk_io = "none"
pseudo_dir = '/opt/QEpot/SSSP_efficiency_pseudos/'
tprnfor = .true.
tstress = .true.
verbosity = 'high'
dt = 50
/
&SYSTEM
ntyp =  5
occupations = 'smearing' !
smearing = "gaussian"
degauss = 0.05
ecutrho = 320
ecutwfc = 40
ibrav = 0
nat = 36
nosym = .TRUE.
!vdw_corr = 'DFT-D3' !you may modify it using ModQEsetting.pl
starting_magnetization(1) =   1.0000000000d-01
starting_magnetization(2) =   3.8461538462d-01
