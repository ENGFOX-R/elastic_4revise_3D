starting_magnetization(4) =   3.8461538462d-01
starting_magnetization(5) =   4.1666666667d-01
nspin = 2
/
&ELECTRONS
conv_thr = 2.d-5
electron_maxstep = 150
mixing_beta = 0.1
mixing_mode = "plain"
mixing_ndim = 4
diagonalization = "david"
diago_david_ndim = 2
/
&IONS
ion_dynamics = "damp"
ion_temperature = "rescaling"
tempw = 300
/
