&CONTROL
calculation = "relax"
nstep = 200
etot_conv_thr = 1.0d-5
forc_conv_thr = 1.0d-4
disk_io = 'none'
pseudo_dir = '/opt/QEpot/SSSP_efficiency_pseudos/'
tprnfor = .true.
tstress = .true.
verbosity = 'high'
dt = 50
/
&SYSTEM
ntyp =  5
occupations = 'smearing' !
smearing = 'gaussian'
degauss =   0.035
ecutrho =   320
ecutwfc =   40 
ibrav = 0
nat = 36
nosym = .TRUE.
!vdw_corr = 'DFT-D3' !you may modify it using ModQEsetting.pl
starting_magnetization(1) =   1.0000000000d-01
starting_magnetization(2) =   3.8461538462d-01
starting_magnetization(3) =   4.1666666667d-01
starting_magnetization(4) =   3.8461538462d-01
starting_magnetization(5) =   4.1666666667d-01
nspin = 2
/
&ELECTRONS
conv_thr =   2.d-5
electron_maxstep = 300
mixing_beta =   0.2
mixing_mode = 'plain' !'local-TF'
mixing_ndim = 8 !set 4 or 3 if OOM-killer exists (out of memory)
diagonalization = 'david' !set cg if if OOM-killer exists (out of memory). other types can be used for scf problem.
diago_david_ndim = 2 !If david is used for diagonalization. set 2 if OOM-killer appears.
/
&IONS
ion_dynamics = "damp"
ion_temperature = "rescaling"
tempw = 1
/
